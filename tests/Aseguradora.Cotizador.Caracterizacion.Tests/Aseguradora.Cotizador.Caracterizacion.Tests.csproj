<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      El cálculo heredado se compila TAL CUAL dentro de las pruebas (archivo enlazado).
      No se referencia el proyecto WinForms: así las pruebas corren en cualquier SO y en CI.
    -->
    <Compile Include="..\..\src\Legacy\Aseguradora.Cotizador.WinForms\CotizadorPrimaLegacy.cs" Link="Legacy\CotizadorPrimaLegacy.cs" />
    <ProjectReference Include="..\..\src\Legacy\Aseguradora.Tarifas\Aseguradora.Tarifas.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Código nuevo: se caracteriza con exactamente las mismas pruebas. -->
    <ProjectReference Include="..\..\src\Aseguradora.Cotizador.Aplicacion\Aseguradora.Cotizador.Aplicacion.csproj" />
    <ProjectReference Include="..\..\src\Aseguradora.Cotizador.Infraestructura\Aseguradora.Cotizador.Infraestructura.csproj" />
  </ItemGroup>

</Project>
