<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!-- La cadena de conexión vive en secrets.config (NO versionado). Ver secrets.config.example -->
  <connectionStrings configSource="secrets.config" />

  <appSettings>
    <!-- En la demo no hay base de datos: el guardado se omite. -->
    <add key="GuardarEnBD" value="false" />
    <!-- Motor de cálculo: Legacy | Sombra | Nuevo. Valor por defecto: Legacy (el código nuevo está presente pero inactivo).
         Se lee en cada clic: revertir = volver a Legacy. Con la app en ejecución el archivo que cuenta es
         bin\Debug\net48\Cotizador.exe.config (en producción, Cotizador.exe.config junto al ejecutable), no este. -->
    <add key="MotorCotizacion" value="Legacy" />
  </appSettings>

  <!-- Modo Sombra: las diferencias [SOMBRA] (Trace.TraceWarning/TraceError) se escriben en sombra.log, junto al ejecutable.
       autoflush="true" vacía el búfer en cada escritura para que el archivo sea legible en vivo. -->
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <add name="sombraLog" type="System.Diagnostics.TextWriterTraceListener" initializeData="sombra.log" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>
