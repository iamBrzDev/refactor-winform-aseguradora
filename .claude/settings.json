{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet run --project src/Aseguradora.Cotizador.Api *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(dotnet add *)",
      "Edit(/src/Legacy/**)"
    ],
    "deny": [
      "Read(**/secrets.config)",
      "Read(**/*.pfx)",
      "Read(**/*.snk)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/appsettings.*.local.json)",
      "Read(/datos-produccion/**)",
      "Edit(**/App.config)",
      "Edit(**/*.exe.config)",
      "Bash(git push --force *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest *)",
      "WebFetch"
    ]
  }
}
